{
  "name": "firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Security rule tests for the Firestore schema, run against the emulator.",
  "scripts": {
    "test": "mocha --timeout 20000 rules.test.js",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-medical-app \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.0",
    "mocha": "^10.4.0"
  }
}
